<!DOCTYPE html>
<html>
<head>
 <title>Student Result System</title>
 <style>
 body { font-family: Arial; 
        margin: 20px;
     }
 input { padding: 6px;
         margin: 4px 0;
         width: 200px; 
         display: block;
         }
 button { padding: 8px;
          margin-top: 10px;
         }
 </style>
</head>
<body>
 <h3>Student Result System </h3>
 <input type="number" id="sub1" placeholder="Subject 1 Marks">
 <input type="number" id="sub2" placeholder="Subject 2 Marks">
 <input type="number" id="sub3" placeholder="Subject 3 Marks">
 <input type="number" id="sub4" placeholder="Subject 4 Marks">
 <input type="number" id="sub5" placeholder="Subject 5 Marks">
 <button onclick="checkResult()">Get Result</button>
 <div id="systemRes" style="margin-top: 15px; font-weight: bold;"></div>
 <script>
 function checkResult() {
 var s1 = Number(document.getElementById("sub1").value);
 var s2 = Number(document.getElementById("sub2").value);
 var s3 = Number(document.getElementById("sub3").value);
 var s4 = Number(document.getElementById("sub4").value);
 var s5 = Number(document.getElementById("sub5").value);
 var total = s1 + s2 + s3 + s4 + s5;
 var per = total / 5;
 var div = "";
 if(per >= 75) div = "Distinction First Class";
 else if(per >= 60) div = "First Class";
 else if(per >= 50) div = "Second Class";
 else if(per >= 35) div = "Pass";
 else div = "Fail";
 document.getElementById("systemRes").innerHTML =
 "Total Marks: " + total + "/500" +"Percentage: " + per + "%" +"Result: " + div;
 }
 </script>
 </body>
</html>
